{
  "name": "@a11y-page-checker/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "dev": "concurrently --kill-others --names api,web \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "test": "vitest run src",
    "start": "node dist/server/bin.js",
    "test:e2e": "playwright test",
    "dev:server": "A11Y_UI_SERVE_CLIENT=false A11Y_UI_ALLOWED_ORIGIN=http://127.0.0.1:5173 tsx watch src/server/bin.ts",
    "dev:client": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@a11y-page-checker/core": "workspace:*",
    "@a11y-page-checker/reporter-html": "workspace:*",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.5.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.0",
    "concurrently": "^9.2.1"
  }
}
